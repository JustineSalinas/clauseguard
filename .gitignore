# dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# next.js
.next/
out/
build/
dist/

# environment — never commit credentials
.env
.env.*
!.env.example

# supabase local
.supabase/
supabase/.branches/
supabase/.temp/

# testing
coverage/
.nyc_output/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# os
.DS_Store
Thumbs.db
desktop.ini

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------------------------------------------------------------
# Project data: contracts are third-party documents. Nothing under
# these paths is committed unless it is synthetic or consented and
# has been reviewed. Default is to keep real contracts out of git.
# ---------------------------------------------------------------
eval/datasets/**/raw/
eval/datasets/**/*.pdf
eval/datasets/**/*.docx
eval/adversarial/**/*.pdf
eval/results/*.csv
eval/results/*.json
!eval/results/.gitkeep

# large corpora — track sources, not dumps
corpus/**/*.jsonl
corpus/**/embeddings/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# playwright mcp scratch
.playwright-mcp/
