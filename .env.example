# Supabase — from Project Settings > API in the Supabase dashboard.
# The publishable key is safe to expose to the browser. The secret / service_role
# key is NOT: it bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_
# and never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Model providers. Server-side only — no NEXT_PUBLIC_ prefix.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# OCR provider (Day 1 decision — must return per-token bounding boxes).
OCR_PROVIDER=
OCR_API_KEY=

# Security test accounts (tests/security). Two real verified accounts.
# User A needs at least one uploaded document; the suite checks user B
# cannot reach it. Local only — never commit real values.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
