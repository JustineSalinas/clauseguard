# Supabase — from Project Settings > API in the Supabase dashboard.
# The publishable key is safe to expose to the browser. The secret / service_role
# key is NOT: it bypasses Row Level Security. Never prefix it with NEXT_PUBLIC_
# and never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret / service_role key. Bypasses RLS completely, so it is the one
# credential that must never reach the browser: no NEXT_PUBLIC_ prefix, and
# lib/supabase/service.ts imports "server-only" so a client-side import fails
# the build rather than shipping it. Pipeline writes only.
SUPABASE_SECRET_KEY=

# Model providers. Server-side only — no NEXT_PUBLIC_ prefix.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Extraction (T3, decided): the PDF text layer via pdfjs, not a cloud OCR.
# Needs no key and no network. See lib/pipeline/extract/README.md for why,
# and for what an OCR fallback would cost the injection research. These two
# stay here, empty, for the scanned-document fallback if it is ever added.
OCR_PROVIDER=
OCR_API_KEY=

# Security test accounts (tests/security). Two real verified accounts.
# User A needs at least one uploaded document; the suite checks user B
# cannot reach it. Local only — never commit real values.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
