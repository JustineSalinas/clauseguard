# Convex (live backend for auth, uploads and the pipeline). `npx convex dev`
# writes both of these to .env.local for you. The app throws "Missing environment
# variable NEXT_PUBLIC_CONVEX_URL" on every page until they exist.
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=

NEXT_PUBLIC_CONVEX_SITE_URL=

# Model providers. Server-side only -- no NEXT_PUBLIC_ prefix. These are
# also set on the Convex deployment itself (npx convex env set), since the
# scoring pipeline runs as a Convex action, not a Next.js route.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional: Muse Spark (Meta Model API) for the LLM clause segmenter. Only read
# when the segmenter mode is "llm"; the rule-based segmenter needs no key.
# Create one at https://dev.meta.ai/api-keys/ (US-only public preview).
META_MODEL_API_KEY=
# "rules" (default) or "llm". Convex env var; per-run override via the
# `segmenter` arg on pipeline.start / pipeline.retry.
SEGMENTER_DEFAULT=
